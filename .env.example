# ==============================================================================
# EVO BILL - SUPABASE & SUPER ADMIN ENVIRONMENT CONFIGURATION
# ==============================================================================

# Supabase Project URL & Anonymous Public Key (Safe for browser / client)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Supabase Service Role Key (STRICTLY CONFIDENTIAL - NEVER EXPOSE IN CLIENT CODE)
# Used only by Next.js Server Actions and secure API routes for admin provisioning
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Super Admin Account
SUPER_ADMIN_EMAIL=workwoeking@gmail.com

# Google Service Account (For per-customer Google Sheets & Drive automation)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
